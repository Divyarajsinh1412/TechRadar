# ====================================================================
# TechRadar — Environment Configuration Template
# Copy this file to .env and supply your credentials.
# NEVER commit your actual .env file with secrets into version control.
# ====================================================================

# 1. Supabase PostgreSQL Database Connection URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Leave empty to automatically fallback to local SQLite database (database/techradar.db)
DATABASE_URL=

# 2. GitHub REST API Token (Personal Access Token)
# Optional but recommended to increase rate limit from 60 req/hr to 5,000 req/hr
# Generate at: https://github.com/settings/tokens (Read-only repo public access)
GITHUB_TOKEN=

# 3. Adzuna Job Market API Credentials
# Register for a developer account at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for job search (e.g., 'in' for India, 'gb' for UK, 'us' for US)
ADZUNA_COUNTRY=in

# 4. Streamlit Server Configuration (For Cloud Hosting / Docker / Render)
PORT=8501
